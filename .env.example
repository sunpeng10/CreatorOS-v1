API_PORT=8000
WEB_PORT=3000
WEB_ORIGIN=http://127.0.0.1:3000
COOKIE_SECURE=false
MIMO_API_KEY=
MIMO_BASE_URL=https://api.xiaomimimo.com/v1
MIMO_MODEL_FAST=mimo-v2.6-flash
MIMO_MODEL_REASONING=mimo-v2.6-pro
# 单次预算在界面中设置，服务端固定最高 10 元。
